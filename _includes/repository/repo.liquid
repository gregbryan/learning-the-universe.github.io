<div class="repo p-2">
  <div class="card h-100">
    <div class="card-body">
      <h5 class="card-title">
        <a href="{{ include.repository.url }}" target="_blank" rel="noopener noreferrer">{{ include.repository.name }}</a>
      </h5>
      {% if include.repository.description %}
        <p class="card-text">{{ include.repository.description }}</p>
      {% endif %}
    </div>
  </div>
</div>
